# Server configuration
PORT=8000
HOST=0.0.0.0

# API Authentication key
AGY_API_KEY=your-secret-key-here

# Safety gate hook flag (1 = active)
AGY_IS_API_CALL=1

# (Optional) Custom path to agy binary (defaults to searching PATH, ~/.local/bin/agy, /usr/local/bin/agy)
# AGY_PATH=/root/.local/bin/agy
